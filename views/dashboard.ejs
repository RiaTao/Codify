<div class="dashboard-section">
    <div class="dashboard-header">
        <div class="user-welcome">
            <img src="<%= user.photo %>" alt="Profile Picture" class="dashboard-profile-pic">
            <div class="welcome-info">
                <h1>Welcome back, <%= user.name %>! 🎉</h1>
                <p class="user-email"><%= user.email %></p>
                <p class="login-time">Logged in at <%= new Date().toLocaleString() %></p>
            </div>
        </div>
    </div>

    <div class="dashboard-content">
        <div class="dashboard-grid">
            <div class="dashboard-card">
                <div class="card-header">
                    <h3>🌟 Hello World Status</h3>
                </div>
                <div class="card-content">
                    <div class="status-indicator">
                        <span class="status-dot active"></span>
                        <span>Authentication Active</span>
                    </div>
                    <p>You are successfully authenticated via Google OAuth 2.0!</p>
                </div>
            </div>

            <div class="dashboard-card">
                <div class="card-header">
                    <h3>👤 Profile Information</h3>
                </div>
                <div class="card-content">
                    <div class="profile-details">
                        <div class="detail-row">
                            <span class="detail-label">User ID:</span>
                            <span class="detail-value"><%= user.id %></span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Display Name:</span>
                            <span class="detail-value"><%= user.name %></span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Email:</span>
                            <span class="detail-value"><%= user.email %></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="dashboard-card">
                <div class="card-header">
                    <h3>🔧 Quick Actions</h3>
                </div>
                <div class="card-content">
                    <div class="action-buttons">
                        <button class="btn btn-primary" onclick="showGreeting()">
                            Say Hello! 👋
                        </button>
                        <a href="/" class="btn btn-secondary">
                            Back to Home
                        </a>
                        <a href="/logout" class="btn btn-danger">
                            Logout
                        </a>
                    </div>
                </div>
            </div>

            <div class="dashboard-card">
                <div class="card-header">
                    <h3>📊 Session Info</h3>
                </div>
                <div class="card-content">
                    <div class="session-info">
                        <p><strong>Session Status:</strong> <span class="status-active">Active</span></p>
                        <p><strong>Authentication Method:</strong> Google OAuth 2.0</p>
                        <p><strong>Security:</strong> Session-based authentication</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Greeting Modal -->
<div id="greetingModal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeGreeting()">&times;</span>
        <h2>Hello <%= user.name %>! 🌟</h2>
        <p>Thanks for trying out our OAuth-enabled Hello World application!</p>
        <p>Your authentication is working perfectly. 🎉</p>
    </div>
</div>

<script>
function showGreeting() {
    document.getElementById('greetingModal').style.display = 'block';
}

function closeGreeting() {
    document.getElementById('greetingModal').style.display = 'none';
}

// Close modal when clicking outside of it
window.onclick = function(event) {
    const modal = document.getElementById('greetingModal');
    if (event.target == modal) {
        modal.style.display = 'none';
    }
}
</script>