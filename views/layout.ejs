<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Hello World OAuth' %></title>
    <link rel="stylesheet" href="/styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <h1 class="nav-title">Hello World OAuth</h1>
            <div class="nav-links">
                <% if (typeof user !== 'undefined' && user) { %>
                    <span class="welcome-text">Welcome, <%= user.name %>!</span>
                    <a href="/dashboard" class="nav-link">Dashboard</a>
                    <a href="/logout" class="nav-link logout-btn">Logout</a>
                <% } else { %>
                    <a href="/" class="nav-link">Home</a>
                <% } %>
            </div>
        </div>
    </nav>

    <main class="main-content">
        <%- body %>
    </main>

    <footer class="footer">
        <p>&copy; 2024 Hello World OAuth. Built with Express.js and Passport.js</p>
    </footer>
</body>
</html>