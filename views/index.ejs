<div class="hero-section">
    <div class="hero-content">
        <h1 class="hero-title">Hello World! 🌍</h1>
        <p class="hero-subtitle">Welcome to our OAuth-enabled Hello World application</p>
        
        <% if (typeof user !== 'undefined' && user) { %>
            <div class="user-info">
                <img src="<%= user.photo %>" alt="Profile Picture" class="profile-pic">
                <h2>Hello, <%= user.name %>! 👋</h2>
                <p class="user-email"><%= user.email %></p>
                <div class="action-buttons">
                    <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
                    <a href="/logout" class="btn btn-secondary">Logout</a>
                </div>
            </div>
        <% } else { %>
            <div class="login-section">
                <p class="login-text">Sign in to personalize your Hello World experience</p>
                <a href="/auth/google" class="btn btn-google">
                    <svg class="google-icon" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                    </svg>
                    Sign in with Google
                </a>
                <p class="privacy-note">
                    We'll only access your basic profile information to personalize your experience.
                </p>
            </div>
        <% } %>
    </div>
</div>

<div class="features-section">
    <div class="features-container">
        <h2>Features</h2>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">🔐</div>
                <h3>Secure OAuth</h3>
                <p>Google OAuth 2.0 integration for secure authentication</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">👤</div>
                <h3>User Profile</h3>
                <p>Access your profile information and personalized dashboard</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🚀</div>
                <h3>Modern Stack</h3>
                <p>Built with Express.js, Passport.js, and modern web technologies</p>
            </div>
        </div>
    </div>
</div>